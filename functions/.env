# Non-secret configuration for Cloud Functions (committed).
# Secrets (e.g. TRAFIKVERKET_API_KEY) live in Secret Manager, never here.

# Polisen's open-data rules require a User-Agent naming the app and a contact address.
# TODO: replace the placeholder address before going live.
INGEST_USER_AGENT="VarningslistaSE/0.1 (+https://varningslista.se; kontakt@varningslista.se)"

# How many days back the initial backfill fetches (Polisen, one day per run).
BACKFILL_DAYS=14
